{
  "name": "@tragram/webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/generate-public-scoped-css.cjs",
    "dev": "next dev",
    "prebuild": "node ./scripts/generate-fontawesome-subset.cjs && node ./scripts/generate-public-scoped-css.cjs",
    "build": "next build && npm run mt-key:guard && npm run css:guard:symbol-badge",
    "build:with-css-budget": "npm run build && node ./scripts/check-css-budgets.cjs",
    "start": "next start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "analytics:config-check": "node ../../scripts/analytics/check-config.mjs",
    "lint": "eslint && npm run css:scan:leak && npm run errors:guard",
    "css:audit": "node ./scripts/audit-css-ownership.cjs",
    "css:public:scope": "node ./scripts/generate-public-scoped-css.cjs",
    "css:report": "node ./scripts/css-usage-report.cjs",
    "css:scan:leak": "node ./scripts/scan-css-leaks.cjs",
    "css:budget": "node ./scripts/check-css-budgets.cjs",
    "css:guard:symbol-badge": "node ./scripts/check-symbol-badge-css-coverage.cjs",
    "auth:css:parity": "python3 ./scripts/auth-css-parity-check.py",
    "visual:parity:capture": "python3 ./scripts/visual-parity-capture.py --output-root ../../output/playwright/visual-check",
    "visual:parity:validate": "python3 ./scripts/visual-parity-validate.py --output-root ../../output/playwright/visual-check",
    "visual:parity:check": "npm run visual:parity:capture && npm run visual:parity:validate",
    "css:fa-subset": "node ./scripts/generate-fontawesome-subset.cjs",
    "theme:guardrails": "node ./scripts/dark-theme-guardrails.cjs",
    "symbols:sync-icons": "node ./scripts/sync-symbol-flags-sprite.cjs",
    "openapi:generate": "openapi-ts",
    "mt-key:guard": "node ./scripts/check-webapp-mt-public-key.mjs",
    "errors:guard": "node ./scripts/api-error-surface-guard.cjs"
  },
  "dependencies": {
    "@fingerprint/react": "^3.1.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@formatjs/intl-localematcher": "^0.5.8",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.12.0",
    "@tragram/types": "*",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "libphonenumber-js": "^1.12.33",
    "lucide-react": "^0.555.0",
    "mixpanel-browser": "^2.83.0",
    "negotiator": "^0.6.4",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.67.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.3.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3",
    "split-type": "^0.3.4",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5",
    "typewriter-effect": "^2.22.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.92.4",
    "@tailwindcss/postcss": "^4",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.15",
    "postcss-selector-parser": "^7.1.0",
    "tailwindcss": "^4"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-musl": "^4.1.17"
  }
}
